{
  "name": "character-forge",
  "version": "0.0.1",
  "description": "AI-assisted character generator extension for SillyTavern",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:quiet": "vitest run 2>&1 | awk '/^\\s*[X✗×]/{print} /Test Files|Tests|Start at|Duration|FAIL|Error/{print}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "prepare": "simple-git-hooks"
  },
  "keywords": [
    "character-card",
    "character-forge",
    "silly-tavern",
    "extension",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run test:quiet"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.5",
    "jsdom": "^24.0.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
